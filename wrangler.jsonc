{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "343shop",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "343shop-products",
      "database_id": "2cd732ec-004b-4921-b49b-b619caea6663"
    }
  ],
  "observability": {
    "enabled": true
  },
  "previews": {}
}
