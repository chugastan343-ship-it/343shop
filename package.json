{
  "name": "343shop",
  "version": "1.2.0",
  "private": true,
  "description": "Bilingual global shopping and brokerage marketplace",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.jsonc",
    "deploy": "wrangler deploy --config ./wrangler.jsonc --assets ./public/",
    "deploy:check": "wrangler deploy --dry-run --config ./wrangler.jsonc --assets ./public/",
    "test": "node --test",
    "deploy.": "npm run deploy"
  },
  "devDependencies": {
    "wrangler": "4.156.1"
  },
  "engines": {
    "node": ">=20"
  }
}
